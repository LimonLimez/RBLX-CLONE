NODE_ENV=development
PORT=3000
DATABASE_PATH=./users.db
JWT_SECRET=replace-this-with-a-long-random-secret-before-production
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000
JSON_BODY_LIMIT=2mb
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20
GAME_WORLDS_DIR=./game-worlds
GAME_SERVER_HOST=127.0.0.1
GAME_SERVER_BASE_PORT=7777
PUBLIC_BASE_URL=http://localhost:3000
SERVER_EXECUTABLE_PATH=../build-portable4/Server.exe
CLIENT_EXECUTABLE_PATH=../build-portable4/Client.exe
